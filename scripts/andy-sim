#!/usr/bin/env bash
# Andy without a robot, for anyone who wants to try it on their own computer (a judge, say).
#
#   ./scripts/andy-sim            (after: cd robot && uv sync; cd voice && uv sync; the keys in the env file)
#
# Pollen's daemon pretends to be a Reachy Mini (--mockup-sim): Andy hears through this computer's default
# microphone, speaks through its speakers and sees through its webcam, and runs exactly as on the robot,
# except that nothing moves (head turns, glances and pointing have no body to show them) and the webcam
# doesn't turn, so finding something looks at one view, four times. Headphones keep Andy from hearing
# itself. The voice server needs an NVIDIA GPU; it is started here if it isn't running already.
# Ctrl-C stops everything this started.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROBOT_PY="$ROOT/robot/.venv/bin"
[ -x "$ROBOT_PY/reachy-mini-daemon" ] || { echo "First: cd robot && uv sync" >&2; exit 1; }
if curl -s -m 2 http://127.0.0.1:8000/api/daemon/status >/dev/null 2>&1; then
  echo "A Reachy Mini daemon is already running on this computer (a real robot?). Use ./scripts/andy instead," >&2
  echo "or stop that daemon first." >&2
  exit 1
fi

# Programs a script starts in the background ignore Ctrl-C, so the two helpers are stopped with SIGTERM;
# Andy runs in the foreground, where Ctrl-C reaches it and it puts the pretend robot to sleep first.
PIDS=()
cleanup() {
  for pid in "${PIDS[@]}"; do kill -TERM "$pid" 2>/dev/null || true; done
  for pid in "${PIDS[@]}"; do wait "$pid" 2>/dev/null || true; done
}
trap cleanup EXIT

echo "Starting a pretend Reachy Mini (this computer's camera, microphone and speakers)…"
"$ROBOT_PY/reachy-mini-daemon" --mockup-sim --fastapi-host 127.0.0.1 &
PIDS+=($!)
for _ in $(seq 1 60); do
  curl -s -m 2 http://127.0.0.1:8000/api/daemon/status >/dev/null 2>&1 && break
  sleep 1
done
curl -s -m 2 http://127.0.0.1:8000/api/daemon/status >/dev/null 2>&1 || { echo "The pretend robot did not start." >&2; exit 1; }

if ! (exec 3<>/dev/tcp/127.0.0.1/8765) 2>/dev/null; then
  echo "Starting the voice server (NVIDIA Parakeet; Nemotron on Nebius Token Factory; the first start downloads models)…"
  "$ROOT/voice/run.sh" &
  PIDS+=($!)
  for _ in $(seq 1 600); do
    (exec 3<>/dev/tcp/127.0.0.1/8765) 2>/dev/null && break
    sleep 1
  done
fi

echo "Starting Andy. Say hello; Ctrl-C to stop."
ANDY_SIM=1 "$ROOT/scripts/andy" "$@" || true
