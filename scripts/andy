#!/usr/bin/env bash
# Run Andy under its supervisor: awake, asleep or quiet, woken by voice, by time, or by a due reminder.
#   ./scripts/andy        (after: cd robot && uv sync)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ANDY_APP_PYTHON="${ANDY_APP_PYTHON:-$ROOT/robot/.venv/bin/python}"   # cd robot && uv sync
[ -x "$ANDY_APP_PYTHON" ] || { echo "First: (cd robot && uv sync)" >&2; exit 1; }
export ANDY_APP_PYTHON PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$ANDY_APP_PYTHON" -m andy_companion.supervisor "$@"
