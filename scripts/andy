#!/usr/bin/env bash
# Run Andy under its supervisor: awake, asleep or quiet, woken by voice, by time, or by a due reminder.
#   ANDY_APP_PYTHON=/path/to/python ./scripts/andy
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
: "${ANDY_APP_PYTHON:?set ANDY_APP_PYTHON to the python of an environment with reachy-mini-conversation-app 1.0.1 and vosk}"
export ANDY_APP_PYTHON PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$ANDY_APP_PYTHON" -m andy_companion.supervisor "$@"
