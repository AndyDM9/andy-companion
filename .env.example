# Copy to ~/.config/companion-hackathon/.env (mode 600). Never commit real keys.
# Each user brings their own keys (decision 0003). Only these are read; nothing else in the file is passed on.

# Nebius Token Factory: the conversation, the eyes, hard questions, the scam check.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Tavily: the web. Its requests carry X-Project-ID (default "andy-companion").
TAVILY_API_KEY=
# TAVILY_PROJECT=andy-companion

# The eyes: token-factory (the default, Nemotron 3.5 Super VL), endpoint (our own, below) or off.
# ANDY_VISION=token-factory
# ANDY_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# With ANDY_VISION=endpoint, the address and token cloud/vision-endpoint.sh prints:
# ANDY_VISION_URL=
# ANDY_VISION_TOKEN=
# The second look (Nemotron 3.5 Content Safety), from cloud/guard-endpoint.sh; without it Andy runs on the word list:
# ANDY_GUARD_URL=
# ANDY_GUARD_TOKEN=

# Nebius AI Cloud, for the endpoint and job scripts in cloud/ (a project whose region allows CPU VMs for jobs):
# NEBIUS_PROJECT=
# NEBIUS_JOB_PROJECT=

# Optional: the GPU for the voice server (default 0), and the screen server's port (default 8090).
# ANDY_VOICE_GPU=1
# ANDY_SCREEN_PORT=8090

# Testing only. Keeps every finder try (pictures of the room, full size) in this folder for scoring.
# Leave it unset at any other time, and always while filming: the pictures show the room and whoever is in it.
# ANDY_FINDER_RECORD=
