[Unit]
Description=Andy, the home companion robot (supervisor: awake, asleep, quiet; screen and family page)
After=andy-voice.service
Wants=andy-voice.service

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/andy
Restart=on-failure
RestartSec=10
# The waits grow to five minutes, so a setting that can't work (no env file, no key) isn't retried every few
# seconds for ever, and the robot still comes back by itself after anything passing (systemd 254 or newer).
RestartSteps=5
RestartMaxDelaySec=300
KillSignal=SIGINT
# The stop goes to the supervisor only, which passes it to the app and waits for it to finish
# (the app sleeps the robot first); anything left after TimeoutStopSec is killed.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
