[Unit]
Description=Andy's offline eyes (NVIDIA Cosmos Reason 2 on this computer, 2B or 8B as the env file says; decision 0015)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/local-eyes
ExecStart=@ROOT@/local-eyes/run.sh
Restart=on-failure
RestartSec=30
# The waits grow to five minutes, so a setting that can't work (no env file, no key) isn't retried every few
# seconds for ever, and the robot still comes back by itself after anything passing (systemd 254 or newer).
RestartSteps=5
RestartMaxDelaySec=300
# vLLM logs no request text (local-eyes/run.sh); keep the journal short anyway.
LogRateLimitIntervalSec=30
LogRateLimitBurst=200

[Install]
WantedBy=default.target
