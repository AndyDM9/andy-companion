#!/usr/bin/env bash
# Block a commit when the tests fail, or when a key-like string is staged.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git diff --cached -U0 | grep -E '^\+' | grep -qE '(tvly-[A-Za-z0-9_-]{20,}|v1\.[A-Za-z0-9_-]{60,}|sk-[A-Za-z0-9]{20,})'; then
  echo "pre-commit: a staged line looks like an API key. Keys live in ~/.config/companion-hackathon/.env." >&2
  exit 1
fi
uv run pytest -q || { echo "pre-commit: tests failed; nothing committed." >&2; exit 1; }
