#!/usr/bin/env bash
# Block a commit when the tests fail, when an env file is staged, or when a key-like string is: Tavily, Nebius,
# OpenAI-style and Hugging Face keys, a 64-hex endpoint token after TOKEN= or KEY=, or a private key.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo "pre-commit: an env file is staged. Keys live in ~/.config/companion-hackathon/.env, never here." >&2
  exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -qE '(tvly-[A-Za-z0-9_-]{20,}|v1\.[A-Za-z0-9_-]{60,}|sk-[A-Za-z0-9]{20,}|hf_[A-Za-z0-9]{30,}|(TOKEN|KEY)=[0-9a-f]{64}|-----BEGIN [A-Z ]*PRIVATE KEY)'; then
  echo "pre-commit: a staged line looks like an API key. Keys live in ~/.config/companion-hackathon/.env." >&2
  exit 1
fi
uv run pytest -q || { echo "pre-commit: tests failed; nothing committed." >&2; exit 1; }
